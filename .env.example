# fake = rule-based stand-in, no key and no network; anthropic = real Claude model
LLM_MODE=fake
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Share of Helpdesk calls that fail with a temporary error (0..1)
HELPDESK_FAILURE_RATE=0.3
HELPDESK_DB_PATH=data/helpdesk.sqlite3
TEMPORAL_HOST=localhost:7233
TASK_QUEUE=tickets
